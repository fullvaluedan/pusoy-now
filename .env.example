# Copy to .env and fill in your Supabase project values.
# The EXPO_PUBLIC_ prefix is required for Expo to inline these into the client bundle.
#
# Without these the app still runs: sign-in reports "Needs Supabase setup" and
# guests play against bots as normal.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Provider setup (no client secrets belong in this file) -------------------
#
# Google:   create an OAuth client in Google Cloud Console, then paste its client
#           id/secret into Supabase > Authentication > Providers > Google.
# Facebook: create an app at Meta for Developers, add Facebook Login, then paste
#           its app id/secret into Supabase > Authentication > Providers >
#           Facebook.
#
# Both need the Supabase callback URL registered with the provider:
#   https://<your-project>.supabase.co/auth/v1/callback
#
# And both need these redirect URLs allowed in
# Supabase > Authentication > URL Configuration:
#   pusoynow://auth-callback     (native)
#   http://localhost:8081        (web dev)

# --- TikTok (U9, not live yet) ------------------------------------------------
#
# TikTok is not a Supabase provider. The client key below is public and only
# starts the Login Kit flow. The client SECRET and the Supabase service-role key
# live exclusively in the tiktok-auth Edge Function's environment, never here
# and never in the app bundle.
# EXPO_PUBLIC_TIKTOK_CLIENT_KEY=your-tiktok-client-key
