{
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-0754432090717206~9571504692",
    "ios_app_id": "ca-app-pub-0754432090717206~2814524653"
  },
  "expo": {
    "name": "Prends",
    "slug": "prends",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/art/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/art/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0e4a3a"
    },
    "scheme": "prends",
    "newArchEnabled": true,
    "ios": {
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true,
      "bundleIdentifier": "app.prends",
      "associatedDomains": [
        "applinks:prends.app"
      ],
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e4a3a",
        "foregroundImage": "./assets/art/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.prends",
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "prends.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/art/app-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-0754432090717206~9571504692",
          "iosAppId": "ca-app-pub-0754432090717206~2814524653"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5978af40-b62c-42c0-ba9b-e4ccfe9e45a3"
      }
    },
    "owner": "fullvaluedan"
  }
}
