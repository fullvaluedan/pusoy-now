{
  "expo": {
    "name": "Prends",
    "slug": "prends",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/art/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/art/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0e4a3a"
    },
    "scheme": "prends",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.prends",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e4a3a",
        "foregroundImage": "./assets/art/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.prends"
    },
    "web": {
      "favicon": "./assets/art/app-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication"
    ]
  }
}
